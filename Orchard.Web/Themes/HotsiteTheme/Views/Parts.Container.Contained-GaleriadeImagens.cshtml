@using Orchard.Utility.Extensions;
@{
    var contentTypeClassName = ((string)Model.ContentItem.ContentType).HtmlClassify();
    var tag = Tag(Model, "div");
    tag.AddCssClass("row");
    var classAnimated = "";
    if(Model.Metadata.DisplayType == "DetailParallax")
    {
        classAnimated = "wow fadeInUp  animated";
    }

    var index = 0;
}


@try
{

    <div class="crsl-wrap row content-wrapper album-wrapper equal-height-list galeriade-imagens list-items content-items @classAnimated">
        <div class="col-lg-12">
            @tag.StartElement
            @foreach (var item in Model.List)
            {
                var attr = "";
                if (index == 0) { attr += "first active"; }
                if (index % 3 == 0 && index > 0)
                {
                    @tag.EndElement
                    @tag.StartElement
                }
                if (Model.Metadata.DisplayType == "DetailParallax" && index >= 6)
                {
                    break;
                }
                <div class="last first crsl-item equal-height-item span-4 col-xs-12 col-sm-12 col-md-4 col-lg-4">
                    @Display(BuildDisplay(item.ContentItem, "Summary"))
                </div>
                ++index;
            }
            @tag.EndElement
        </div>
    </div>

}
catch (System.Exception ex) { }




@if (Model.Metadata.DisplayType != "DetailParallax")
{
    <div class="row">
        @Display(Model.Pager)
    </div>

}