@{

    string nameInstitute = WorkContext.Layout.NomeInstituicao.ToString();

    string siteName = Convert.ToString(WorkContext.CurrentSite.SiteName);

    string secretariaVinculado = WorkContext.Layout.SecretariaVinculado.ToString();

    string urlSecretariaVinculado = WorkContext.Layout.UrlSecretariaVinculado.ToString();

    if (string.IsNullOrEmpty(urlSecretariaVinculado)) {
        urlSecretariaVinculado = "javascript:void(0);";
    }

    var tag = Tag(Model, "p");
    tag.AddCssClass("contact-info");
    var contato = Model.Contato;
    @tag.StartElement

                if(!string.IsNullOrEmpty(contato.Site)){
                    @Html.Raw("<a title=\"Acessar site\" href=\"" + contato.Site + "\" target=\"_blank\">");
                }

                    <span class="name-institute">
                        @if (!string.IsNullOrEmpty(contato.Instituicao) || !string.IsNullOrEmpty(nameInstitute))
                        {
                            if (!string.IsNullOrEmpty(contato.Instituicao))
                            { @Html.Raw(contato.Instituicao) }
                            else {
                                @Html.Raw(nameInstitute)
                            }

                        }
                        else {
                            @Html.Raw(siteName)
                        }
                    </span>

                if (!string.IsNullOrEmpty(contato.Site))
                {
                    @Html.Raw("</a>");
                }

                if (!string.IsNullOrEmpty(secretariaVinculado)){
                    @Html.Raw("<br/><a title=\"Acessar site\"  href=\"" + @urlSecretariaVinculado + "\" target=\"_blank\">" + @secretariaVinculado + "</a>");
                }
                <br /><a href="http://www.es.gov.br/" class="link-gov-es" target="_blank" title="Acessar site">Governo do Estado do Espírito Santo</a>
                <br />

    @tag.EndElement

}