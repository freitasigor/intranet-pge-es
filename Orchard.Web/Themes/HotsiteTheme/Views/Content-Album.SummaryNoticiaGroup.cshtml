@using Orchard.ContentManagement;
@using Orchard.Utility.Extensions;
@{


    var title = "";
    var excerpts = "";
    dynamic imageObject = null;
    var urlImage = "";

    Orchard.ContentManagement.ContentItem contentItem = Model.ContentItem;

    try
    {
        title = Model.ContentItem.TitlePart.Title.ToString();
    }
    catch (System.Exception) { title = ""; }

    try
    {
        if (!String.IsNullOrEmpty(Model.ContentItem.Album.Descricao.Value))
        {
            string excerptHtml = Model.ContentItem.Album.Descricao.Value;
            var excerptObj = new HtmlString(Html.Excerpt(excerptHtml, 200).ToString().Replace(Environment.NewLine, "</p>" + Environment.NewLine + "<p>"));
            excerpts = excerptObj.ToString();

        }
    }
    catch (System.Exception ex) { excerpts = ""; }



}


<div class="thumbnail recent-post">
    @{

        <div class="img  hidden-xs">
            <a href="@Url.ItemDisplayUrl(contentItem)" title="Leia mais">
                @if (!String.IsNullOrEmpty(Model.ContentItem.Album.ImagemdeCapa.FirstMediaUrl))
            {
                foreach (var content in Model.ContentItem.Album.ImagemdeCapa.MediaParts)
                {
                        @Display(Model.ContentItem.ContentManager.BuildDisplay(content, "SummaryImagemdeDestaqueGallery"))
                    }
                }
                else if (!String.IsNullOrEmpty(Model.ContentItem.Album.Imagens.FirstMediaUrl))
                {
                    @Display(Model.ContentItem.ContentManager.BuildDisplay(Model.ContentItem.Album.Imagens.MediaParts[0], "SummaryImagemdeDestaqueGallery"))
                }
            </a>
        </div>

    }
    <div class="caption">
        <div class="date-post">
            @if (!((DateTime?)Model.ContentItem.CommonPart.PublishedUtc).HasValue)
            {
                @T("Rascunho");
            }
            else
            {
                @Display.DateTime(DateTimeUtc: Model.ContentItem.CommonPart.CreatedUtc, CustomFormat: T("dd/MM/yyyy"));
            }
        </div>
        <h4 class="title-post"><a href="@Url.ItemDisplayUrl(contentItem)" title="@title">@title</a></h4>
        <div>
            @Html.Raw(excerpts)
        </div>
        <div class="recent-read-more learn-more">
            <a href="@Url.ItemDisplayUrl(contentItem)" title="Ver Fotos" class="btn btn-primary btn-md background-primary-button-background-color primary-button-border-border-color font-color-primary-button-color">Ver Fotos</a>
        </div>
    </div>
</div>
                

                           