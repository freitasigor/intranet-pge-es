@using Orchard.Mvc.Html;
@using Orchard.UI.Resources;
@{
    RegisterLink(new LinkEntry { Type = "image/x-icon", Rel = "shortcut icon", Href = "//cdn.es.gov.br/images/favicons/governo/favicon.ico" });
    Script.Include("//cdn.es.gov.br/scripts/extensions/html5shiv/3.7.2/html5shiv.min.js").UseCondition("lt IE 9").AtHead();
    Script.Include("//cdn.es.gov.br/scripts/extensions/respond/1.4.2/respond.min.js").UseCondition("lt IE 9").AtHead();


    string nameInstitute = WorkContext.Layout.NomeInstituicao.ToString();
    string abbreviationInstitute = WorkContext.Layout.SiglaInstituicao.ToString();

    string title = Convert.ToString(Model.Title);
    string siteName = Convert.ToString(WorkContext.CurrentSite.SiteName);


    /*Define siteName custom*/
    if (!String.IsNullOrEmpty(nameInstitute))
    {
        siteName = nameInstitute;
    }
    else if (!String.IsNullOrEmpty(abbreviationInstitute))
    {
        siteName = abbreviationInstitute;
    }

    /*Define siteName and title custom*/
    if (String.IsNullOrEmpty(title))
    {
        if (!String.IsNullOrEmpty(abbreviationInstitute) && !String.IsNullOrEmpty(nameInstitute))
        {
            title = nameInstitute;
            siteName = abbreviationInstitute;
        }
    }
    else
    {
        if (!String.IsNullOrEmpty(abbreviationInstitute))
        {
            siteName = abbreviationInstitute;
        }
    }

}
