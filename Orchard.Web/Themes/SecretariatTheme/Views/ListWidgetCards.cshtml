@using Orchard.Utility.Extensions;
@{

    Model.Id = "list-cards-" + Model.ContentItem.Id;
    var tag = Tag(Model, "div");
    tag.AddCssClass("col-lg-12 row-licitacoes list-cards");
    var list = Model.ContentItems;

    bool orchardPager = false;
    if (Model.ContentItem.ProjectionPart.Record.DisplayPager) { orchardPager = true; }

}



@*==================================================*@
<style>


</style>


<div class="row">


    <!-- begin Filtro Licitacoes-->
    <div class="filter-licitacao" style="display:none;">
        <div id="filter-cards" data-orchard-pagination="@orchardPager.ToString().ToLower()">
            <div id="placeHolder"></div>
            <div class="row">
                <div class="col-lg-12">
                    <div id="legend"></div>
                </div>
            </div>
            <div class="row container-filter-reset">
                <div class="col-lg-6 text-left">
                    <div id="reset" style="display: none;"><span class="btn btn-default submit filter-reset">Remover filtros</span></div>
                </div>
                <div class="col-lg-6 text-right">
                    <div id="quant-founds"></div>
                </div>
            </div>            

        </div>
    </div>
    <!-- end Filtro Licitacoes-->
    @*==================================================*@


    <div class="row custom-list-link">



            <div id="list-cards">
                @tag.StartElement
                    @foreach (var item in list)
                    {

                        @Display(BuildDisplay(item, "SummaryCard"))

                    }
                @tag.EndElement
            </div>


    </div>
</div>

@Display(Model.Pager)
<ul data-container="@Model.Id" class="pager filter-pagination ocult"></ul>
