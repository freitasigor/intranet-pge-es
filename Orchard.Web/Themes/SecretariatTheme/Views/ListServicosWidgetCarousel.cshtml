@using Orchard.Taxonomies.Models;
@using Orchard.ContentManagement;
@using Orchard.Utility.Extensions;
@using Orchard.Mvc.Html;
@using System.Linq;
@{

    /*Para o correto funcionamento do Slider é nessecesario definir um valor para o Model.Id e
 * adicionar a classe 'slider' e 'rp-carousel' ao Model.Classes*/
    Model.Id = "slider-" + Model.ContentItem.Id;
    Model.Classes.Add("slider");
    Model.Classes.Add("rp-carousel");

    var tag = Tag(Model, "div");
    tag.AddCssClass("row");
    tag.AddCssClass("row-servicos");
    var list = Model.ContentItems;
    var contentManager = Model.ContentItem.ContentManager;
    var index = 0;
    var count = 0;

}


@tag.StartElement

    @try
    {
        @*Count itens in Enumerable*@
        foreach (var item in list)
        {
            count++;
            if(count >= 5)//numero maximo de itens a exibir por vez
            {
                break;
            }
        }
        if(count > 1 && count < 3){ count = 3; }//numero minimo de itens a exibir por vez

    <div class="col-lg-12 list-thumb-row">

        <div class="crsl-items carousel slide crsl-items content-items-wrapper content-partners-wrapper" id="carousel-@Model.Id" data-carousel="true" data-navigation="@(Model.ContentItem.Id)" data-speed="700" data-visible="@count" data-autorotate="7000">
            <div class="crsl-wrap row">

                @foreach (var item in list)
                {
                    var attr = "";
                    if (index == 0) { attr += "first active"; }

                    <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3 crsl-item text-center @attr ">
                        @Display(BuildDisplay(item, "SummaryCarousel"))
                    </div>

                    ++index;
                }
            </div>
        </div>
    </div>

    }
    catch (System.Exception ex) { }
@tag.EndElement

