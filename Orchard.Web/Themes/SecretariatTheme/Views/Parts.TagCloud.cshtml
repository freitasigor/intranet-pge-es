<div id="tag-cloud-id" class="tag-cloud-container"></div>

@using (Script.Foot())
{
    <script type="text/javascript">
        var words = [
            @foreach (TagCount tagCount in Model.TagCounts) {
                @Html.Raw("{text: \""+@tagCount.TagName+"\", weight: "+ @tagCount.Bucket + ", link: \""+ @HttpUtility.UrlDecode(Url.Action("Search", "Home", new { area = "Orchard.Tags", tagName = tagCount.TagName }, null)) + "\"},")
            }
        ];

        $('#tag-cloud-id').jQCloud(words, {
            delay: 50,
            autoResize: true,
            height: 150
        });
    </script>
}