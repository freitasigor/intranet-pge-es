@model Orchard.Tags.ViewModels.TagsSearchViewModel
@{ 
    Html.AddTitleParts(T("Tags").ToString()); 
    Html.AddTitleParts(T("Contents tagged with {0}", Model.TagName).ToString());
    Model.List.Classes.Add("tagged-posts");
    Model.List.Classes.Add("content-items");
}
<article class="span-12 col-xs-12 col-md-12 col-sm-12 col-lg-12">
    <div class="span-12 col-xs-12 col-md-12 col-sm-12 col-lg-12">
        <header class="row">
            <div class="span-12 col-xs-12 col-md-12 col-sm-12 col-lg-12">
                <h2 class="title-content title-content-summary page-title">@T("Contents tagged with <span>{0}</span>", Model.TagName)</h2>
            </div>
        </header>
        <div class="row content-container">
            <div class="span-12 col-xs-12 col-md-12 col-sm-12 col-lg-12">
                @Display(Model.List)
                @Display(Model.Pager)
            </div>
        </div>
    </div>
</article>