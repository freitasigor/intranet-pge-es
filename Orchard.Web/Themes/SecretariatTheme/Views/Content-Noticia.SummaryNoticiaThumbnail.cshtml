@using Orchard.ContentManagement;
@using Orchard.Utility.Extensions;
@{


    var title = "";
    var excerpts = "";
    var urlImage = "";
    var widthCol = "9";
    Orchard.ContentManagement.ContentItem contentItem = Model.ContentItem;


    try
    {
        title = Model.ContentItem.TitlePart.Title.ToString();
    }
    catch (System.Exception) { title = ""; }

    try
    {
        excerpts = Model.ContentItem.ResumoPart.Resumo.Value.ToString();
    }
    catch (System.Exception) { excerpts = ""; }

    var listFieldsThumb = Model.ContentItem.ImagemPart.Fields;

}


        @foreach(var fields in listFieldsThumb){
            foreach(var image in fields.MediaParts){   
                urlImage = image.MediaUrl;
                <div class="hidden-xs col-xs-12 col-sm-3 col-md-3 col-lg-3 list-thumb-image" style="margin-left:15px; margin-right: -15px;" >
                    <div  class="thumbnail album-image-item img " >
                        <img src="@Display.ResizeMediaUrl(Width: 168, Height: 112, Mode: "crop", Alignment: "middlecenter", Path: image.MediaUrl)" alt="@image.Title" />                                                    
                        <div class="overlay">
                            <a href="@Url.ItemDisplayUrl(contentItem)" title="Leia mais" class="expand"><span class="mybutton">Leia Mais</span></a>
                        </div> 
                    </div>                                               
                </div>
                                                  
            }                                        
        }
        @if(urlImage == ""){widthCol = "12";} else{widthCol = "9";}

        <div class="col-xs-12 col-sm-@widthCol col-md-@widthCol col-lg-@widthCol info" style="padding-left: 0;">
            <div class="container-fluid">
                <div class="row title title-link title-list-thumb">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                        <h4 class="title-list">
                            <a href="@Url.ItemDisplayUrl(contentItem)" class="link-color-color" title="@title">
                                @title
                            </a>
                        </h4>
                    </div>
                </div>
             
                    <div class="col-lg-12" style="padding-left: 0;">
                        <div class="published">
                            @if (!((DateTime?)Model.ContentItem.CommonPart.PublishedUtc).HasValue)
                            {
                                @T("Rascunho");
                            }
                            else
                            {
                                @Display.DateTime(DateTimeUtc: Model.ContentItem.CommonPart.CreatedUtc, CustomFormat: T("dd/MM/yyyy HH'h'mm"));
                            }
                        </div>
                    </div>
          
                <div class="row description text-justify">
                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                        @if (!String.IsNullOrEmpty(excerpts))
                        {                
                            @Html.Raw(excerpts)<span>...</span>
                        }
                        <a href="@Url.ItemDisplayUrl(contentItem)" class="link-color-color" title="Leia mais">Leia mais</a>
                    </div>
                </div>

            </div>        
        </div>
                

                           