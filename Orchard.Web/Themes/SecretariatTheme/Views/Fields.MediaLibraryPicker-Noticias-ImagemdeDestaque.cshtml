@using Orchard.ContentManagement
@using Orchard.MediaLibrary.Fields
@using Orchard.MediaLibrary.Models
@using Orchard.Utility.Extensions;


@{
    var field = (MediaLibraryPickerField) Model.ContentField;
    string name = field.DisplayName;
    var contents = field.MediaParts;
}
<section class="row media-library-picker-field media-library-picker-field-@name.HtmlClassify()">
   
    @foreach(var content in contents) {
    <div class="col-lg-12">
        <div  class="thumbnail container-thumbnail" >
            <div class="row-thumbnail" >
                <img src="@Display.ResizeMediaUrl(Width: 960, Height: 480, Mode: "crop", Alignment: "middlecenter", Path: content.MediaUrl)" title="@Model.Title" alt="@Model.Title" />
            </div>
             @if(content.Title!=""){<strong class="legend-photo">@content.Caption</strong>}
            
        </div>
    </div>
    }
</section>

