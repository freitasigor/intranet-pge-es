
@functions {
    // To support the layout classifaction below. Implementing as a razor function because we can, could otherwise be a Func<string[], string, string> in the code block following.
    string CalcuClassify(string[] zoneNames, string classNamePrefix)
    {
        var zoneCounter = 0;
        var zoneNumsFilled = string.Join("", zoneNames.Select(zoneName => { ++zoneCounter; return Model[zoneName] != null ? zoneCounter.ToString() : ""; }).ToArray());
        return HasText(zoneNumsFilled) ? classNamePrefix + zoneNumsFilled : "";
    }
}
@{

    /* Global includes for the theme
    ***************************************************************/

    SetMeta("charset", "utf-8");
    SetMeta(httpEquiv: "X-UA-Compatible", content: "IE=edge,chrome=1");
    SetMeta("viewport", "width=device-width, initial-scale=1.0");
    SetMeta(httpEquiv: "Content-Language", content: "pt-br, pt, en");
    SetMeta("author", "PRODEST");

    /*Custom Meta*/
    SetMeta("reply-to", "atendimento@prodest.es.gov.br");
    SetMeta("description", "Aplicativo criado para o cidadão capixaba informar irregularidades ou sugestões, e assim participar da administração pública do Estado do Espírito Santo.");
    SetMeta("keywords", "SECONT, Fiscal Cidadão, administração pública, fiscal, cidadão, sugestões, PRODEST, governo, Estado do Espírito Santo");

    /* begin Styles
    **************************************/

    Style.Include("//cdn.es.gov.br/fonts/open-sans/1.0.0/css/open-sans.min.css").AtHead().SetAttribute("data-timestamped", "true");
    Style.Include("bootstrap.min.css").UseCondition("!IE").AtHead().SetAttribute("data-timestamped", "true");/*Not IE*/
    Style.Include("bootstrap-ie/ie/css/bootstrap-ie.min.css").UseCondition("gte IE 8").AtHead().SetAttribute("data-timestamped", "true");/*Bootstrap IE8+*/
    Style.Include("bootstrap-ie/ie7/css/bootstrap-ie7.min.css").UseCondition("lt IE 8").AtHead().SetAttribute("data-timestamped", "true");/*Bootstrap IE7*/
    Style.Include("bootstrap-ie/ie7/css/bootstrap-ie7-responsive.min.css").UseCondition("lt IE 8").AtHead().SetAttribute("data-timestamped", "true");/*Bootstrap Responsive IE7*/
    Style.Include("fiscal-cidadao/fonts/geometos-rounded/1.0.0/css/geometos-rounded.css");
    Style.Include("fiscal-cidadao/ie6.css").UseCondition("lt IE 7").AtHead().SetAttribute("data-timestamped", "true");/*IE6*/
    Style.Include("fiscal-cidadao/main-fiscal-cidadao.css").AtHead().SetAttribute("data-timestamped", "true");
    /* end Styles
    ***************************************/

    /* begin Scripts
    **************************************/
    Script.Require("jQuery").AtFoot();
    Script.Include("//cdn.es.gov.br/bootstrap/3.3.2/js/bootstrap.min.js").AtFoot();

    /* end Scripts
    ***************************************/


    /* Some useful shortcuts or settings
    ***************************************************************/

    Func<dynamic, dynamic> Zone = x => Display(x); // Zone as an alias for Display to help make it obvious when we're displaying zones



    /* Last bit of code to prep the layout wrapper
    ***************************************************************/
    Model.Id = "layout-wrapper";
    var tag = Tag(Model, "div"); // using Tag so the layout div gets the classes, id and other attributes added to the Model

}

@tag.StartElement


