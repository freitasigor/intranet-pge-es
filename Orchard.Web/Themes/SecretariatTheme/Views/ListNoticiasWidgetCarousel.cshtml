@using Orchard.ContentManagement;
@using Orchard.Utility.Extensions;
@{

/*Para o correto funcionamento do Slider é nessecesario definir um valor para o Model.Id e 
 * adicionar a classe 'slider' ao Model.Classes*/
Model.Id = "slider-"+Model.ContentItem.Id;
Model.Classes.Add("slider");


var tag = Tag(Model, "div");
tag.AddCssClass("row");
var list =  Model.ContentItems;

IEnumerable<object> enumContentItens = list;
var quantItemList = enumContentItens.Count();

var index = 0;
          
@tag.StartElement

    <div class="col-lg-12 list-thumb-row">
        <div id="carousel-@Model.Id" class="carousel slide carousel-news" data-ride="carousel">

            <!-- Wrapper for slides -->
            <div class="carousel-inner" role="listbox">
                @foreach (var item in list)
                {
                    var attr = "";


                    if (index == 0) { attr += "first active"; }
                    

                    <div class="item @attr">
                        @Display(BuildDisplay(item, "SummaryNoticiaCarousel"))
                    </div>

                    index++;
                }
            </div>

            <!-- Indicators -->
            @if (quantItemList > 1) {
            <ol class="carousel-indicators">
                @for (var i = 0; i < quantItemList; i++)
                {
                    var classIndicator = "";
                    if (i == 0) { classIndicator += "first active"; }
                    <li data-target="#carousel-@Model.Id" data-slide-to="@i" class="@classIndicator"></li>
                }
            </ol>
            }

        </div>

    </div>

@tag.EndElement
<!--/main slider carousel--> 

}