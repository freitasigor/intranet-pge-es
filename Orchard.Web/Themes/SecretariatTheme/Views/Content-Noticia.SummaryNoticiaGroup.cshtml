@using Orchard.ContentManagement;
@using Orchard.Utility.Extensions;
@{


    var title = "";
    var excerpts = "";
    dynamic imageObject = null;
    var urlImage = "";

    Orchard.ContentManagement.ContentItem contentItem = Model.ContentItem;

    try
    {
        title = Model.ContentItem.TitlePart.Title.ToString();
    }
    catch (System.Exception) { title = ""; }

    try
    {
        string excerptHtml = Model.ContentItem.ResumoPart.Resumo.Value.ToString();
        var excerptsTemp = new HtmlString(Html.Excerpt(excerptHtml, 180).ToString().Replace(Environment.NewLine, "</p>" + Environment.NewLine + "<p>"));
        excerpts = excerptsTemp.ToString();
    }
    catch (System.Exception) { excerpts = ""; }



}


<div class="row item-carousel">

    @{
        var listFieldsThumb = Model.ContentItem.ImagemPart.Fields;
        foreach (var fields in listFieldsThumb)
        {
            foreach (var image in fields.MediaParts)
            {
                urlImage = image.MediaUrl;
                imageObject = image;
            }
        }
        <div class="thumbnail bg-img-container hidden-xs">
            <div class="img">
                <a href="@Url.ItemDisplayUrl(contentItem)" title="Leia mais">
                    @if (!String.IsNullOrEmpty(urlImage))
                    {
                        @Display(Model.ContentItem.ContentManager.BuildDisplay(imageObject.ContentItem, "SummaryImagemdeDestaqueCarousel"))
                    }
                </a>
            </div>
        </div>

    }

    <div class="col-lg-12">

        <div class="date-item-carousel">
            @if (!((DateTime?)Model.ContentItem.CommonPart.PublishedUtc).HasValue)
            {
                @T("Rascunho");
            }
            else
            {
                @Display.DateTime(DateTimeUtc: Model.ContentItem.CommonPart.CreatedUtc, CustomFormat: T("dd/MM/yyyy"));
            }
        </div>
        <h4 class="title-item-carousel"><a href="@Url.ItemDisplayUrl(contentItem)" title="Leia mais">@title</a></h4>
        <p class="excerpt-item-carousel">@Html.Raw(excerpts)</p>

        <div class="text-right learn-more">
            <a href="@Url.ItemDisplayUrl(contentItem)" title="Leia mais">
                                    
                <i class="ion-ios-plus-empty"></i>
            </a>
        </div>
    </div>



</div>
                

                           