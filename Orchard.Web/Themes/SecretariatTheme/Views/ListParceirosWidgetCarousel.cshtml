@using Orchard.Utility.Extensions;
@{

    /*Para o correto funcionamento do Slider é nessecesario definir um valor para o Model.Id e
 * adicionar a classe 'slider' e 'rp-carousel' ao Model.Classes*/
    Model.Id = "slider-" + Model.ContentItem.Id;
    Model.Classes.Add("slider");
    Model.Classes.Add("rp-carousel");

    var tag = Tag(Model, "div");
    tag.AddCssClass("row");
    var list = Model.ContentItems;
    var index = 0;
}
@tag.StartElement

<div class="col-lg-12 list-thumb-row">

    <div class="crsl-items carousel slide crsl-items content-items-wrapper content-partners-wrapper" id="carousel-@Model.Id" data-carousel="true" data-navigation="@(Model.ContentItem.Id)" data-speed="700" data-visible="3" data-autorotate="3500">
        <div class="crsl-wrap row">

            @foreach (var item in list)
            {
                var attr = "";
                if (index == 0) { attr += "first active"; }
                <div class="col-xs-12 col-sm-12 col-md-3 col-lg-3 crsl-item @attr ">
                    @Display(BuildDisplay(item, "SummaryParceiros"))
                </div>
                ++index;
            }

        </div>
    </div>
</div>
@tag.EndElement
<!--/main slider carousel-->
