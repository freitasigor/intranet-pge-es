@using Orchard.Utility.Extensions;
@{
    /*Para o correto funcionamento do Slider é nessecesario definir um valor para o Model.Id e 
     * adicionar a classe 'slider' ao Model.Classes*/
    Model.Id = "slider-" + Model.ContentItem.Id;
    //Model.Classes.Add("slider");

    var tag = Tag(Model, "div");
    tag.AddCssClass("row");
    var list = Model.ContentItems;
    var index = 0;
}

@tag.StartElement

<div class="col-lg-12">
    <div id="carousel-@Model.Id" class="carousel slide gallery carousel-slider" data-ride="carousel">

        <div class="carousel-inner" role="listbox">
            @foreach (var item in list)
            {
                var attr = "";
                if (index == 0) { attr = "first active"; }
                <div class="item @attr">
                    @Display(BuildDisplay(item, "SummarySlide"))
                </div>
                index++;
            }
        </div>
        @if (index > 1)
        {

        <!-- Indicators -->
            <ol class="carousel-indicators">
                @for (var i = 0; i < index; i++)
                {
                    var attr = "";
                    if (i == 0) { attr = "first active"; }
                    <li data-target="#carousel-@Model.Id" data-slide-to="@i" class="@attr"></li>
                }
            </ol>

        <!-- Controls -->
            <a class="left carousel-control fade" href="#carousel-@Model.Id" role="button" data-slide="prev">
                <i class="fa fa-angle-left" aria-hidden="true"></i>
                <span class="sr-only">Previous</span>
            </a>
            <a class="right carousel-control fade" href="#carousel-@Model.Id" role="button" data-slide="next">
                <i class="fa fa-angle-right" aria-hidden="true"></i>
                <span class="sr-only">Next</span>
            </a>

        }

    </div>
</div>
@tag.EndElement
