<Placement>
  <!-- Customize where the shapes are rendered -->

  <!-- 
  <Place Parts_Blogs_BlogArchives="Content:before"/>
  <Place Parts_Blogs_RecentBlogPosts="Content:after"/>
  <Match ContentType="Blog">
    <Match DisplayType="Summary">
      <Place Parts_Blogs_Blog_Description="Content:before"
             Parts_Blogs_Blog_BlogPostCount="Meta:3"/>
    </Match>
  </Match>
  <Match Path="/About">
    <Place Parts_Common_Metadata="-"/>
  </Match>
-->

  
  <Match DisplayType="Detail">
    <Place Fields_MediaLibraryPicker="Content:before" />
    <Place Fields_TaxonomyField-Categoria="-" />
    <!--<Place Fields_Boolean="-" />-->
    <Place Parts_Common_Metadata="-" />
    <Place Fields_Common_Text-Resumo="-" />
    <Place Parts_Tags_ShowTags="Content:10" />
    <Place Parts_CommentForm="Content:10.2" />
    <Place Parts_ListOfComments="Content:10.3" />
    <Place Fields_Enumeration-BackgroundColor="-" />
    <Place Fields_Enumeration-ColumnWidth="-" />
    <Place Fields_Enumeration-ExibiremDispositivoMovel="-" />
  </Match>
  <Match DisplayType="Summary">
    <Place Fields_TaxonomyField="Meta:1" />
    <Place Parts_Tags_ShowTags="-" />
    <Place Fields_Common_Text__Resumo="-" />
    <Place Parts_Common_Metadata_Summary="-" />
    <!--<Place Fields_MediaLibraryPicker="Content:1" />  -->
  </Match>

  <Match ContentType="Noticia">
    <Match DisplayType="Detail">
      <Place Parts_Common_Metadata="Header:before" />
      <Place Parts_Title="wrapper=Wrapper__Noticia;Header:5" />
      <Place Fields_MediaLibraryPicker-ImagemdeDestaque="Content:before.2" />
      <Place Fields_TaxonomyField-Categoria="-" />
      <Place Fields_Common_Text-Resumo="-" />
      <Place Fields_MediaLibraryPicker-GaleriadeImagens="Content:10"/>
      <Place Parts_Tags_ShowTags="Content:10.1" />
      <Place Parts_CommentForm="Content:10.2" />
      <Place Parts_ListOfComments="Content:10.3" />
    </Match>
    <Match DisplayType="Summary">
      <Place Fields_TaxonomyField="Meta:0" />
      <Place Parts_Title_Summary="Meta:1" />
      <Place Parts_Common_Metadata_Summary="Meta:2" />
      <Place Parts_Tags_ShowTags="-" />
      <Place Fields_Common_Text-Resumo="-" />
    </Match>
  </Match>

  <Match ContentType="Eventos">
    <Match DisplayType="Summary">
      <Place Parts_Common_Metadata_Summary="-" />
      <Place Parts_Comments_Count="-" />
      <Place Fields_DateTime__DataInicial="Content:after.1" />
      <Place Fields_DateTime__DataFinal="Content:after.2" />
      <Place Fields_Common_Text__Local="Content:after.3" />
      <Place Fields_Common_Text__Resumo="-" />
    </Match>
    <Match DisplayType="Detail">
      <Place Fields_DateTime="-" />
      <Place Fields_Common_Text__Resumo="-" />
    </Match>
  </Match>
  <Match ContentType="AcessoRapido">
    <Match DisplayType="Summary">
      <Place Fields_ContentPicker="-" />
    </Match>
  </Match>
  <Match ContentType="MidiasSociais">
    <Match DisplayType="Summary">
      <Place Fields_Enumeration="Content:before" />
    </Match>
  </Match>
  <Match ContentType="Page">
    <Match DisplayType="Detail">
      <Place Parts_Common_Metadata="-" />
      <Place Fields_ContentPicker="Content:after" />
      <Place Parts_Tags_ShowTags="Content:after" />
    </Match>
  </Match>


  <Match ContentType="GrupodeArquivos">
    <Match DisplayType="Summary">
      <Place Fields_Common_Text__Descricao="Content:before" />
    </Match>
  </Match>

  <Match ContentType="Album">
    <Match DisplayType="Detail">
      <Place Fields_Common_Text-Descricao="-" />
    </Match>
  </Match>

  <Match ContentType="GrupodeVideos">
    <Match DisplayType="Summary">
      <Place Parts_OEmbed="Content:before" />
    </Match>
  </Match>

  <Match ContentType="ListadeLinks">
    <Match DisplayType="SummaryContentPicker">
      <Place Parts_Title="-" />
      <Place Fields_Common_Text="-" />
      <Place Fields_Boolean="-" />
      <Place Parts_Common_body_Summary="-" />
      <Place Parts_Common_body="-" />
      <Place Parts_Container_Contained="Content:2" />
    </Match>
     <Match DisplayType="Detail">
      <Place Fields_Common_Text="-" />
      <Place Fields_Boolean="-" />
    </Match>
  
  </Match>
  


  <Match ContentType="ListadeContatos">
    <Place Fields_Boolean__AgruparporTitulo="-" />
  </Match>


  <Match ContentType="Image">
    <Match DisplayType="Detail">
      <Place Parts_Title="-" />
      <Place Fields_Common_Text__Fotografo="Content:before" />
    </Match>
  </Match>


  <Match ContentType="TipodeServicoTerm">
    <Match DisplayType="Detail">
      <Place Fields_Enumeration-Icone="-" />
    </Match>
  </Match>


</Placement>
